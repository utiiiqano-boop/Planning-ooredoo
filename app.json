{
  "expo": {
    "name": "Planning Ooredoo",
    "slug": "planning-ooredoo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "planning-ooredoo",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
