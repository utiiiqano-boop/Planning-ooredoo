        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E30613"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "aa3db7a5-795a-42e3-9a0d-f97f5474f493"
      }
